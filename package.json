{
  "name": "rate-repository-app",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "formik": "^2.4.9",
    "graphql": "^17.0.2",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.3",
    "react-router-native": "^6.30.6",
    "rxjs": "^7.8.2",
    "yup": "^1.7.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
